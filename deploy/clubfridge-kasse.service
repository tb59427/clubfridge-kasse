[Unit]
Description=Clubfridge Kasse
Documentation=https://github.com/clubfridge-dev/clubfridgeV2
After=network-online.target
Wants=network-online.target
# StartLimit* MUSS ins [Unit]-Segment — in [Service] wirft systemd ab Trixie
# eine "Unknown key"-Warnung und ignoriert es.
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
User=%i
# Service-Mode rendert direkt über KMSDRM (Drop-in kmsdrm.conf setzt
# SDL_VIDEODRIVER=kmsdrm). Wir setzen daher KEIN DISPLAY/XAUTHORITY —
# sonst fällt SDL2 bei blockiertem KMSDRM stillschweigend auf Xwayland
# zurück und die Rotation wird gegenüber dem Compositor verdoppelt.
Environment=KIVY_NO_ENV_CONFIG=1

WorkingDirectory=/opt/clubfridge/kasse
ExecStart=/opt/clubfridge/kasse/.venv/bin/python main.py

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=clubfridge-kasse

# Sandboxing deaktiviert: WLAN-Setup braucht sudo/nmcli,
# und mehrere Protect*-Optionen setzen implizit NoNewPrivileges=true

[Install]
# multi-user.target reicht — die Kasse rendert direkt in KMSDRM, kein
# graphisches Ziel noetig. Wenn der Installer default=multi-user setzt
# (typisch nach lightdm-mask), landet ein Symlink in graphical.target.wants
# nutzlos → Service startet nie. Fix fuer den Trixie/Desktop-Bug.
WantedBy=multi-user.target
